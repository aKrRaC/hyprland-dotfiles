configuration {
    font: "Inter Regular 10";
    sidebar-mode: false;
    fullscreen: false;
    threads: 0;
    matching: "fuzzy";
    scroll-method: 0;
    monitor: "primary";
    kb-cancel: "Escape,MousePrimary";
}

* {
    transparent: #00000000;

    foreground: #F2F2F2EE;
    foreground-selected: #F2F2F2EE;

    background-selected: #F2F2F245;
    background-active: #F2F2F230;
    background-white: #F2F2F211;
    background-black: #00000000;

    urgent: #E91E6366;
    urgent-selected: #E91E6377;
}

window {
    transparency: "real";
    background-color: #191724AF;
    location: center;
    anchor: center;
    width: 480px;
    height: 320px;
    border: 0;
    border-radius: 9px;
}

mainbox {
    spacing: 10px;
    padding: 12px;
    background-color: @transparent;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 14px;
    margin: 0 0 12px 0;
    background-color: #1917244F;
    border-radius: 9px;
    children: [ entry ];
}

entry {
    font: "Inter Regular 12";
    background-color: transparent;
    text-color: #F1F1F1;
    placeholder: "Search Clipboard";
    placeholder-color: #6e6a86;
    expand: true;
    horizontal-align: 0;
    vertical-align: 0.5;
    blink: true;
}

listview {
    background-color: transparent;
    lines: 4;
    spacing: 8px;
    cycle: true;
    dynamic: false;
    scrollbar: false;
}

element {
    orientation: horizontal;
    background-color: transparent;
    text-color: @foreground;
    border: 0;
    border-radius: 6px;
    spacing: 16px;
    margin: 0;
    padding: 10px 14px;
}

element-icon {
    size: 22px;
    background-color: transparent;
}

element-text {
    font: "Inter Regular 11";
    expand: true;
    horizontal-align: 0;
    vertical-align: 0.5;
    color: @foreground;
    background-color: transparent;
}

element normal.active,
element alternate.active {
    background-color: @background-active;
    text-color: @foreground;
}

element normal.urgent,
element alternate.urgent {
    background-color: @urgent;
    text-color: @foreground;
}

element selected {
    background-color: @background-white;
    text-color: @foreground;
}

element selected.active {
    background-color: #403d5220;
    text-color: @foreground-selected;
}

element selected.urgent {
    background-color: @urgent-selected;
    text-color: @foreground;
}

scrollbar {
    enabled: false;
}
